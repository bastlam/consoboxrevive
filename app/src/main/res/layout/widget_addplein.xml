<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 widget. The whole widget is the click target (id addplein): opens "add a fill-up". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/addplein"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cb_widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/widget_subtitle"
        android:src="@drawable/cb_widget_icon" />

    <TextView
        android:id="@id/widgetaddplein_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/widget_short"
        android:textColor="@color/cb_widget_text"
        android:textSize="12sp" />
</LinearLayout>
