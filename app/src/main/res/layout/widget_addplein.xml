<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 widget, icon only. The whole widget is the click target (id addplein): opens "add a fill-up". -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/addplein"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cb_widget_bg"
    android:contentDescription="@string/widget_subtitle"
    android:padding="6dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/cb_widget_icon" />
</FrameLayout>
