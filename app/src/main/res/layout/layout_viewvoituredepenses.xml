<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/viewvoiture_contentdepenses"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- timeline line on the left -->
    <ImageView
        android:id="@id/viewsvoiture_poteaudepense"
        android:layout_width="20dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="16dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/poteau" />

    <ListView
        android:id="@id/view_voiture_depenses"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="-10dp"
        android:layout_toRightOf="@id/viewsvoiture_poteaudepense"
        android:clipToPadding="false"
        android:divider="#00000000"
        android:paddingTop="4dp"
        android:paddingBottom="88dp" />

    <!-- month header pinned while scrolling -->
    <RelativeLayout
        android:id="@id/depensesmonthpinned"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="26dp"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/month"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="14dp">

            <TextView
                android:id="@id/type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/cb_on_secondary_container"
                android:textSize="14sp" />

            <TextView
                android:id="@id/prix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:textColor="@color/cb_on_secondary_container"
                android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>

    <Button
        android:id="@id/view_voiture_ajouterdepense"
        style="@style/Widget.ConsoBox.Fab"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:contentDescription="@string/ajouter" />
</RelativeLayout>
