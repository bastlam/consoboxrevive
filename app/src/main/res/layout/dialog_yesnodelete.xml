<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/YesNoDelete_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical|right"
    android:minWidth="280dp"
    android:orientation="horizontal"
    android:paddingLeft="24dp"
    android:paddingTop="8dp"
    android:paddingRight="24dp"
    android:paddingBottom="16dp">

    <ImageView
        android:id="@id/YesNoDelete_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:src="@drawable/alert" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <Button
        android:id="@id/YesNoDetele_no"
        style="@style/Widget.ConsoBox.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:text="@string/non" />

    <Button
        android:id="@id/YesNoDetele_yes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/oui" />
</LinearLayout>
