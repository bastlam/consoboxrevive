    <string name="DB_VOITURE">CREATE TABLE IF NOT EXISTS voiture (id INTEGER PRIMARY KEY AUTOINCREMENT,nom VARCHAR, type VARCHAR, km INT(7), kmbase INT(7), cv INT(4), cvf INT(2), photo VARCHAR);</string>
    <string name="DB_CONSO">CREATE TABLE IF NOT EXISTS conso (id INTEGER PRIMARY KEY AUTOINCREMENT,voiture INTEGER, date DATE, volume DOUBLE,km DOUBLE, prix DOUBLE, partiel BOOLEAN);</string>
    <string name="DB_REVISION">CREATE TABLE IF NOT EXISTS revisions (voiture INTEGER, type INTEGER, dateLast DATE,kmLast INTEGER,freqKm INTEGER,freqDate INTEGER,valide INTEGER,PRIMARY KEY(voiture,type));</string>
    <string name="DB_LIST_OF_REVISION">CREATE TABLE IF NOT EXISTS list_of_revision (id INTEGER,carburant INTEGER,nom VARCHAR,categorie INTEGER,freqKm INTEGER,freqDate INTEGER,supprimable INTEGER,visible INTEGER,PRIMARY KEY(id,carburant));</string>
    <string name="DB_DEPENSES">CREATE TABLE IF NOT EXISTS depenses (id INTEGER PRIMARY KEY AUTOINCREMENT,voiture INTEGER, type INTEGER, date DATE,km INTEGER,prix DOUBLE,description VARCHAR);</string>
    <string name="DB_PNEU">CREATE TABLE IF NOT EXISTS pneu (id INTEGER PRIMARY KEY AUTOINCREMENT,voiture INTEGER, marque VARCHAR, date_achat DATE,date_montage DATE,km INTEGER,temps_monte INTEGER,prix DOUBLE,description VARCHAR,modele VARCHAR, usable boolean, used integer, hiver boolean);</string>
