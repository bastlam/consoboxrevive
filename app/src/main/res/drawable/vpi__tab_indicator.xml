<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:gravity="bottom" android:height="3dp" android:left="12dp" android:right="12dp">
                <shape android:shape="rectangle">
                    <corners android:topLeftRadius="3dp" android:topRightRadius="3dp"/>
                    <solid android:color="@color/cb_primary"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F00796B"/>
        </shape>
    </item>
    <item android:drawable="@android:color/transparent"/>
</selector>
